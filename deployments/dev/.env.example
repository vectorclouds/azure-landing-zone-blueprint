# .env.example
# Copy this file to .env and fill in your actual values
# The .env file will be ignored by git (.gitignore includes .env)

# =============================================================================
# AZURE AUTHENTICATION
# =============================================================================
# Your Azure subscription ID
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# Optional: If using service principal for local development
# AZURE_CLIENT_ID=your-service-principal-client-id
# AZURE_CLIENT_SECRET=your-service-principal-secret
# AZURE_TENANT_ID=your-azure-tenant-id

# =============================================================================
# TERRAFORM BACKEND (Optional for local development)
# =============================================================================
# If you want to use remote state storage
# TERRAFORM_STATE_RG=rg-terraform-state
# TERRAFORM_STATE_STORAGE=tfstateYOURUNIQUEID
# TERRAFORM_STATE_CONTAINER=tfstate

# =============================================================================
# PROJECT CONFIGURATION
# =============================================================================
# Storage account name - must be globally unique
STORAGE_ACCOUNT_NAME=youruniquestorageacct001

# Resource group name
RESOURCE_GROUP_NAME=rg-storage-module-dev

# Azure region
AZURE_LOCATION=East US

# Project information
PROJECT_NAME=Azure Landing Zone Blueprint
ENVIRONMENT=dev
OWNER=Your Name or Team

# =============================================================================
# USAGE INSTRUCTIONS
# =============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Edit .env with your actual values
# 3. Source the environment: source .env (Linux/Mac) or . .\.env.ps1 (PowerShell)
# 4. Run terraform commands